# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter model id (must support tool/function calling for routing + tools)
MODEL_ID=openai/gpt-4o-mini

# Routing confidence below this triggers the clarify flow (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.6
